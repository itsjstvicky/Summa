{
  "entities": {
    "Portfolio": {
      "title": "Portfolio",
      "description": "Main portfolio presentation data",
      "type": "object",
      "properties": {
        "greeting": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "shortBio": { "type": "string" },
        "longBio": { "type": "string" },
        "location": { "type": "string" },
        "locationText": { "type": "string" },
        "availabilityText": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "ctaText": { "type": "string" },
        "ctaLink": { "type": "string" },
        "profileImage": { "type": "string" },
        "tagline": { "type": "string" },
        "faviconUrl": { "type": "string" },
        "resumeUrl": { "type": "string" }
      },
      "required": ["name", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "Portfolio showcased project entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "shortDescription": { "type": "string" },
        "fullDescription": { "type": "string" },
        "summary": { "type": "string" },
        "aboutProject": { "type": "string" },
        "thumbnail": { "type": "string" },
        "projectUrl": { "type": "string" },
        "tags": { "type": "array" },
        "date": { "type": "string" },
        "featured": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "order": { "type": "number" },
        "accentColor": { "type": "string" },
        "bgColor": { "type": "string" },
        "roles": { "type": "array" },
        "outputs": { "type": "array" },
        "workflow": { "type": "array" },
        "impactDescription": { "type": "string" },
        "impactMetrics": { "type": "array" }
      },
      "required": ["id", "title", "category"]
    },
    "Skill": {
      "title": "Skill",
      "description": "Technical or creative skill proficiency item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "proficiency": { "type": "number" },
        "visible": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "category"]
    },
    "Experience": {
      "title": "Experience",
      "description": "Work experience or career timeline entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "role": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "currentPosition": { "type": "boolean" },
        "description": { "type": "string" },
        "responsibilities": { "type": "string" },
        "projects": { "type": "string" },
        "achievements": { "type": "string" },
        "companyLogo": { "type": "string" },
        "visible": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "companyName", "role"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Desktop, taskbar, start menu or wallpaper configuration setting",
      "type": "object",
      "properties": {
        "updatedAt": { "type": "string" }
      }
    },
    "Contact": {
      "title": "Contact",
      "description": "Contact info and social media profile links",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "instagram": { "type": "string" },
        "linkedin": { "type": "string" },
        "behance": { "type": "string" },
        "dribbble": { "type": "string" },
        "youtube": { "type": "string" },
        "github": { "type": "string" },
        "twitter": { "type": "string" }
      }
    },
    "Message": {
      "title": "Message",
      "description": "Visitor contact submission message",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "message"]
    },
    "MasterState": {
      "title": "MasterState",
      "description": "Full CMS state snapshot for backup and fast restore",
      "type": "object",
      "properties": {
        "lastSyncedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/portfolio/{docId}": {
      "schema": "Portfolio",
      "description": "Public portfolio details"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Showcased portfolio projects"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Creative and technical skills"
    },
    "/experiences/{expId}": {
      "schema": "Experience",
      "description": "Work history and experience"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "System desktop, taskbar and wallpaper settings"
    },
    "/contact/{contactId}": {
      "schema": "Contact",
      "description": "Contact methods and social links"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Submitted visitor messages"
    },
    "/cms_state/{stateId}": {
      "schema": "MasterState",
      "description": "Master CMS state snapshot"
    }
  }
}
